<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="22dp"
    android:gravity="center_horizontal"
    android:background="@drawable/bg_search_input">

    <FrameLayout
        android:id="@+id/bioIconContainer"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="#EFF6FF">

        <ImageView
            android:id="@+id/bioIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_menu_camera"
            app:tint="#2563EB" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvBioModalTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Perekaman Sidik Jari"
        android:textColor="#111827"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvBioModalSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Silakan ikuti instruksi panduan di bawah ini pada scanner."
        android:textColor="#6B7280"
        android:textSize="12sp"
        android:gravity="center" />

    <LinearLayout
        android:id="@+id/bioStepIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvStepDot1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1. Scan Awal"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#2563EB"
            android:background="#EFF6FF"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" › "
            android:textColor="#94A3B8"
            android:textSize="16sp"
            android:layout_marginHorizontal="6dp" />

        <TextView
            android:id="@+id/tvStepDot2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2. Konfirmasi"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#94A3B8"
            android:background="#F8FAFC"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:background="#F8FAFC"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="STATUS PERANGKAT"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvBioDeviceBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Menghubungkan"
                android:textColor="#0369A1"
                android:background="#E0F2FE"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBioStepText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Menghubungkan ke pemindai..."
            android:textColor="#1E293B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBioHintText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Pastikan scanner biometrik di kasir aktif dan terhubung."
            android:textColor="#64748B"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBioCancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Batal"
            android:textColor="#111827"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="#F3F4F6"
            app:strokeColor="#E5E7EB"
            app:strokeWidth="1dp"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBioRetry"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Coba Lagi"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="#2563EB"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBioDone"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Selesai"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="#059669"
            app:cornerRadius="8dp" />
    </LinearLayout>
</LinearLayout>
